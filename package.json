{
	"name": "easter-date",
	"version": "1.2.0",
	"author": "Roman Ožana <roman@ozana.cz> (https://ozana.cz)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OzzyCzech/easter-date.git"
	},
	"license": "MIT",
	"description": "Calculate the date of Easter for a given year",
	"keywords": [
		"easter",
		"date",
		"calendar",
		"holly week"
	],
	"type": "module",
	"exports": {
		"types": "./dist/index.d.ts",
		"default": "./dist/index.js"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"release": "npx np",
		"prepare": "npm run build",
		"test": "tsc --noEmit && vitest",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"docs": "typedoc"
	},
	"engines": {
		"node": ">=22"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@ozzyczech/tsconfig": "^2.1.0",
		"@types/node": "^25.9.3",
		"np": "^11.2.1",
		"tsx": "^4.22.4",
		"typedoc": "^0.28.19",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
