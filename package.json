{
	"name": "easter-date",
	"version": "2.0.1",
	"author": "Roman Ožana <roman@ozana.cz> (https://ozana.cz)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OzzyCzech/easter-date.git"
	},
	"license": "MIT",
	"description": "Calculate the date of Easter for a given year",
	"keywords": [
		"easter",
		"date",
		"calendar",
		"holly week"
	],
	"type": "module",
	"exports": {
		"types": "./dist/index.d.ts",
		"default": "./dist/index.js"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepare": "pnpm run build",
		"test": "tsc --noEmit && vitest",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"docs": "typedoc"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.24.0",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@ozzyczech/tsconfig": "^2.1.0",
		"@types/node": "^26.5.1",
		"tsx": "^4.23.13",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	}
}
